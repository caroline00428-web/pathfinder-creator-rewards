# ════════════════════════════════════════════════════════════════
# Staging Environment Configuration
# 隔离测试环境（与生产环境完全独立）
# ════════════════════════════════════════════════════════════════

# 📊 Database (MUST CREATE NEW TURSO DB)
# 使用一个 staging 用的新数据库，完全隔离生产数据
# 创建步骤：
#   1. 访问 https://turso.tech
#   2. 创建新数据库，命名为 "creator-reward-staging"
#   3. 复制 Database URL 和 Auth Token 到下面
TURSO_DATABASE_URL="libsql://creator-reward-staging-[your-org].turso.io"
TURSO_AUTH_TOKEN="[staging-auth-token]"

# 🔐 NextAuth (生成新的 secret)
# 生成方法: openssl rand -base64 32
NEXTAUTH_SECRET="[generate-new-secret-for-staging]"
NEXTAUTH_URL="https://[staging-url].vercel.app"

# 📹 YouTube API (可使用同一个 key)
YOUTUBE_API_KEY="AIzaSyB6m_Vk2bmMXEuIZqw3TD9B5xiRC9fteno"

